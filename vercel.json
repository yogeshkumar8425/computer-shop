{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.py": {
      "excludeFiles": "{classroom.sqlite3*,.env,.env.*,__pycache__/**,*.py[cod],.git/**,supabase/**}"
    },
    "api/**/*.py": {
      "excludeFiles": "{classroom.sqlite3*,.env,.env.*,__pycache__/**,*.py[cod],.git/**,supabase/**}"
    }
  },
  "rewrites": [
    { "source": "/api/public/course", "destination": "/api/public-course" },
    { "source": "/api/public/enroll", "destination": "/api/public-enroll" }
  ]
}
